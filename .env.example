# ─── Choose ONE of these LLM providers ──────────────────────────────────────
#
# A) Local model via Ollama (default — no API costs, runs offline)
#    1. brew install ollama   # or download from https://ollama.com
#    2. brew services start ollama   # starts the API on localhost:11434
#    3. ollama pull qwen2.5:3b
#    4. keep the two lines below
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
# LLM_API_KEY is only needed if your local server requires one. Leave blank
# for Ollama.
# LLM_API_KEY=
#
# B) OpenAI — comment out the two lines above and uncomment this:
# OPENAI_API_KEY=sk-...
#
# Optional: change the port the server listens on
# PORT=5173
